{
  "name": "lynceus-mcp",
  "version": "1.6.0",
  "description": "MCP server for Lynceus — web search + URL→Markdown extraction for AI agents. RU-web-first.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lynceus-mcp": "dist/cli.js",
    "lyn-mcp": "dist/cli.js"
  },
  "files": [
    "dist/api.js",
    "dist/api.d.ts",
    "dist/api.js.map",
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/cli.js.map",
    "dist/server.js",
    "dist/server.d.ts",
    "dist/server.js.map",
    "dist/sanitize.js",
    "dist/sanitize.d.ts",
    "dist/sanitize.js.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --reporter=dot",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "search",
    "extract",
    "markdown",
    "russian-web",
    "anti-bot",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
